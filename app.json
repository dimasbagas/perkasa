{
  "expo": {
    "name": "perpuskab",
    "slug": "perpus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/pemda.png",
    "scheme": "perpuskab",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dimasbagas.perpuskab",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/pemda.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/pemda.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "extraGradleParams": "-Xmx4g"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "dimasbagasf",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4a88ee45-8bd4-4df9-9d9d-be357c6c7fa1"
      }
    }
  }
}
